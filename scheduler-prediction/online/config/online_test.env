# Copy to online_test.env and edit values.

# Core cluster settings
ZONE=europe-west2-c
CONTROL_NODE=k3s-control
WORKER_NODES="k3s-worker-2 k3s-worker-3 k3s-worker-4 raspberrypi"
NODES="k3s-control k3s-worker-2 k3s-worker-3 k3s-worker-4 raspberrypi"

# Telemetry/campaign settings
INTERVAL=1.0
SSH_RETRIES=4
SSH_RETRY_DELAY=20
COLLECTOR_STARTUP_TIMEOUT=120
NETDATA_BASE_URL=http://localhost:20000

# Campaign shape
RUNS=6
CONTROL_RATIO=0.25
BASELINE=120
RECOVERY=120
DURATIONS="90 120 150"
SEED=42
START_AT=1
LIMIT=

# Model/scheduler settings used by readiness smoke
MODEL_DIR=scheduler-prediction/prediction/models/phase4_weighted_calibrated_fair_cohort_20260423_183525_retry
WINDOW=5
PRED_WEIGHT=0.8
ANOMALY_WEIGHT=0.2
ANOMALY_HISTORY=45
ANOMALY_SOURCE=nsa
NSA_NUM_DETECTORS=120
NSA_RADIUS=0.9
KMEANS_THRESHOLD_STD=2.0
Z_THRESHOLD=2.5
ADAPTIVE_WEIGHTING=true
ADAPTIVE_RISK_LOW=0.2
ADAPTIVE_RISK_HIGH=0.7
ADAPTIVE_MAX_SHIFT=0.35
ADAPTIVE_MIN_PREDICTION_WEIGHT=0.05
ADAPTIVE_MAX_PREDICTION_WEIGHT=0.95
CONTENTION_RELATIVE_CPU_THRESHOLD=1.0
CONTENTION_PENALTY_FACTOR=0.1
SAFE_RELATIVE_CPU_THRESHOLD=1.0
UNSAFE_PENALTY_FACTOR=0.25
AVOID_UNSAFE_NODES=true

# Stage B scheduler-authority settings
K8S_NAMESPACE=default
DEFAULT_SCHEDULER_NAME=default-scheduler
CUSTOM_SCHEDULER_NAME=custom-rank-scheduler
STAGE_B_RUNS=10
STAGE_B_WORKLOADS="cpu-pod memory-pod mixed-pod"
STAGE_B_ARM_ORDER_MODE=counterbalanced
STAGE_B_WARMUP_SAMPLES=24
STAGE_B_WARMUP_INTERVAL=1.0
STAGE_B_WASHOUT_SECONDS=8
STAGE_B_STRESS_PROFILES="cpu memory mixed"
# Stage B support services should run on k3s-control with ephemeral storage so every worker remains stressable.
STAGE_B_SUPPORT_STORAGE_MODE=ephemeral
STAGE_B_SUPPORT_NODE_HOSTNAME="k3s-control"
STAGE_B_NETDATA_SUPPORT_HOSTNAME="k3s-control"
# Keep the original PVC-backed host available for restoration outside Stage B if needed.
STAGE_B_NETDATA_STATEFUL_HOSTNAME="k3s-worker-2"
STAGE_B_STRESS_TARGETS="k3s-worker-2 k3s-worker-3 k3s-worker-4 raspberrypi"
STAGE_B_STRESS_TIMEOUT=180
STAGE_B_STRESS_STARTUP_SECONDS=10
STAGE_B_STRESS_NICE_LEVEL=10
CUSTOM_SCHEDULER_MANIFEST=scheduler-prediction/online/k8s/custom-rank-scheduler.yaml

# Python environment
VENV_PATH=.venv
