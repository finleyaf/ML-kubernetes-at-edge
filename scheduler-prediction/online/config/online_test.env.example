# Copy to online_test.env and edit values.

# Core cluster settings
ZONE=europe-west2-c
CONTROL_NODE=k3s-control
WORKER_NODES="k3s-worker-2 k3s-worker-3"
NODES="k3s-control k3s-worker-2 k3s-worker-3"

# Telemetry/campaign settings
INTERVAL=1.0
SSH_RETRIES=4
SSH_RETRY_DELAY=20
COLLECTOR_STARTUP_TIMEOUT=120
NETDATA_BASE_URL=http://localhost:20000

# Campaign shape
RUNS=6
CONTROL_RATIO=0.25
BASELINE=120
RECOVERY=120
DURATIONS="90 120 150"
SEED=42
START_AT=1
LIMIT=

# Model/scheduler settings used by readiness smoke
MODEL_DIR=scheduler-prediction/prediction/models/phase4_weighted_calibrated
WINDOW=5
PRED_WEIGHT=0.9
ANOMALY_WEIGHT=0.1
ANOMALY_HISTORY=45
Z_THRESHOLD=3.5

# Python environment (optional)
VENV_PATH=.venv
